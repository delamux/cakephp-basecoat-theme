{#
/**
 * BasecoatTheme bake template: `calendar` screen (`bin/cake bake screen calendar`).
 * Reads the view variables of data.php (year, month, today, categories, resources, days, dayStart, dayEnd, events).
 * Twig variables used: `namespace`, `useDomain` and `plugin` (strings use `__d('<plugin>', ...)`
 * under `--plugin`, `__()` otherwise, as bake's CRUD templates). The rest is the PHP view.
 */
-#}
{% set t = useDomain ? "__d('" ~ plugin ~ "', " : "__(" %}
<?php
/**
 * Calendar: month, week and day views (CalendarHelper) with a side panel of upcoming events and a legend.
 *
 * Views (GET, no JavaScript needed): `?view=month|week|day` and `?date=Y-m-d` (`?month=Y-m` is still
 * accepted). The week has a column per weekday of `$days`, the day a column per resource; both show the
 * hours from `$dayStart` to `$dayEnd` as rows. The week's day headers open that day.
 *
 * Interactivity of the month (BasecoatTheme.basecoat-dnd + basecoat-screens; without JavaScript the page
 * is unchanged): drag an event chip to another day (keyboard: focus it, Space, arrows, Space or Enter);
 * "+N more" shows the rest of the day's events in place. Week and day are read-only.
 *
 * @var \{{ namespace }}\View\AppView $this
 * @var int $year Year of the month shown by default.
 * @var int $month Month shown by default (1-12).
 * @var string $today The current day as `Y-m-d` (from your action: the template does not read the clock).
 * @var array<string, string> $categories Category key => label.
 * @var array<string, string> $resources Resource key => name (people, companies...): the columns of the day view.
 * @var array<int> $days Weekdays of the week view, in column order (0 = Sunday ... 6 = Saturday).
 * @var string $dayStart First hour of the week and day views (H:i).
 * @var string $dayEnd End of the week and day views (H:i, `24:00` allowed).
 * @var array<int, array<string, mixed>> $events Events: id, title, date (`Y-m-d`), time (`H:i` or null for all
 *   day), end (`H:i`, optional), resource (key of $resources, optional), category, url (optional).
 */
use Cake\I18n\Date;

$this->assign('title', {{ t|raw }}'Calendar'));

$resources ??= [];
$days ??= [1, 2, 3, 4, 5];
$dayStart ??= '08:00';
$dayEnd ??= '20:00';
// TODO: give each event a `url` (your event view action); chips and blocks link to `#` until then.

// View and date from the query string; invalid values fall back to the month of today.
$query = $this->getRequest()->getQueryParams();
$view = in_array($query['view'] ?? null, ['month', 'week', 'day'], true) ? $query['view'] : 'month';
$parse = function (mixed $value, string $format): ?Date {
    if (!is_string($value)) {
        return null;
    }
    $parsed = DateTimeImmutable::createFromFormat('!' . $format, $value);

    return $parsed !== false && $parsed->format($format) === $value ? new Date($parsed->format('Y-m-d')) : null;
};
$todayDate = $parse($today, 'Y-m-d');
$current = $parse($query['date'] ?? null, 'Y-m-d') ?? $parse($query['month'] ?? null, 'Y-m');
if ($current === null && $view === 'month' && isset($year, $month)) {
    $current = $parse(sprintf('%04d-%02d-01', $year, $month), 'Y-m-d');
    if ($current !== null && $todayDate !== null && $todayDate->format('Y-m') === $current->format('Y-m')) {
        $current = $todayDate;
    }
}
$current ??= $todayDate;
$date = $current->format('Y-m-d');

$link = fn (string $view, ?Date $day = null): array => ['action' => 'index', '?' => ['view' => $view] + ($day ? ['date' => $day->format('Y-m-d')] : [])];
$dayUrl = fn (string $day): array => ['action' => 'index', '?' => ['view' => 'day', 'date' => $day]];
$grid = ['date' => $date, 'today' => $today, 'categories' => $categories, 'dayUrl' => $dayUrl];

if ($view === 'month') {
    $this->Html->script('BasecoatTheme.basecoat-dnd', ['block' => 'script', 'defer' => true]);
    $this->Html->script('BasecoatTheme.basecoat-screens', ['block' => 'script', 'defer' => true]);
    $this->Html->css('BasecoatTheme.interactivity', ['block' => 'css']);
    $heading = $current->i18nFormat('LLLL y');
    $previous = $link('month', $current->modify('first day of previous month'));
    $next = $link('month', $current->modify('first day of next month'));
    $labels = [{{ t|raw }}'Previous month'), {{ t|raw }}'Next month')];
} elseif ($view === 'week') {
    $columns = $this->Calendar->weekDates($date, $days);
    $heading = (new Date($columns[0]))->i18nFormat('d MMM') . ' – ' . (new Date(end($columns)))->i18nFormat('d MMM y');
    $previous = $link('week', $current->subDays(7));
    $next = $link('week', $current->addDays(7));
    $labels = [{{ t|raw }}'Previous week'), {{ t|raw }}'Next week')];
} else {
    $heading = $current->i18nFormat('EEEE d MMMM y');
    $previous = $link('day', $current->subDays(1));
    $next = $link('day', $current->addDays(1));
    $labels = [{{ t|raw }}'Previous day'), {{ t|raw }}'Next day')];
}
$views = ['month' => {{ t|raw }}'Month'), 'week' => {{ t|raw }}'Week'), 'day' => {{ t|raw }}'Day')];

$upcoming = array_values(array_filter($events, fn (array $e): bool => $e['date'] >= $today));
usort($upcoming, fn (array $a, array $b): int => [$a['date'], (string)($a['time'] ?? ''), (string)$a['title']] <=> [$b['date'], (string)($b['time'] ?? ''), (string)$b['title']]);
$upcoming = array_slice($upcoming, 0, 5);
$dots = [
    'meeting' => 'bg-blue-500',
    'deadline' => 'bg-red-500',
    'release' => 'bg-green-500',
    'team' => 'bg-amber-500',
];
?>
<div class="flex min-w-0 flex-col gap-4 px-4 md:gap-6 lg:px-6">
    <?= $this->PageHeader->render({{ t|raw }}'Calendar'), [
        'level' => 2,
        'description' => {{ t|raw }}'Meetings, deadlines and releases at a glance.'),
        'actions' => [
            // TODO: point "New event" at your own add action.
            $this->Button->link({{ t|raw }}'New event'), '#', ['icon' => 'plus']),
        ],
    ]) ?>

    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2">
            <?= $this->Button->icon('chevron-left', $labels[0], ['url' => $previous, 'variant' => 'outline', 'data-nav' => 'prev']) ?>
            <?= $this->Button->icon('chevron-right', $labels[1], ['url' => $next, 'variant' => 'outline', 'data-nav' => 'next']) ?>
            <?= $this->Button->link({{ t|raw }}'Today'), $link($view), ['variant' => 'outline', 'data-nav' => 'today']) ?>
            <h3 class="ml-1 text-lg font-semibold"><?= h($heading) ?></h3>
        </div>
        <nav class="flex items-center gap-1" aria-label="<?= h({{ t|raw }}'Calendar view')) ?>">
            <?php foreach ($views as $key => $label) : ?>
                <?= $this->Button->link($label, $link($key, $current), ['variant' => $key === $view ? 'secondary' : 'ghost', 'size' => 'sm', 'aria-current' => $key === $view ? 'true' : null, 'data-view' => $key]) ?>
            <?php endforeach; ?>
        </nav>
    </div>

    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_16rem]">
        <?php if ($view === 'month') : ?>
            <div class="relative min-w-0 overflow-x-auto rounded-lg border">
                <?php // TODO: add 'attributes' => ['data-endpoint' => '<your move action URL>'] to save moves ({action: 'move', id, from, to, index}: from / to are the days, Y-m-d; failures are reverted). ?>
                <?= $this->Calendar->month($events, $grid) ?>
            </div>
        <?php elseif ($view === 'week') : ?>
            <?= $this->Calendar->week($events, $grid + ['days' => $days, 'start' => $dayStart, 'end' => $dayEnd, 'resources' => $resources]) ?>
        <?php else : ?>
            <?= $this->Calendar->day($events, $grid + ['start' => $dayStart, 'end' => $dayEnd, 'resources' => $resources]) ?>
        <?php endif; ?>

        <aside class="flex min-w-0 flex-col gap-4" aria-label="<?= h({{ t|raw }}'Calendar details')) ?>">
            <section class="rounded-lg border p-4" aria-labelledby="calendar-upcoming">
                <h3 class="mb-3 text-sm font-semibold" id="calendar-upcoming"><?= h({{ t|raw }}'Upcoming')) ?></h3>
                <?php if ($upcoming) : ?>
                    <ul class="flex flex-col gap-3">
                        <?php foreach ($upcoming as $event) : ?>
                            <?php
                            // Mirror of the chip: after a drag the date follows ({short}) and the list stays in date order
                            $sortTail = '|' . ($event['time'] ?? '') . '|' . $event['title'];
                            ?>
                            <li class="flex items-start gap-3" data-upcoming="<?= h((string)$event['id']) ?>" data-dnd-sort="<?= h('{container-id}' . $sortTail) ?>" data-dnd-sort-key="<?= h($event['date'] . $sortTail) ?>">
                                <span class="mt-1.5 size-2 shrink-0 rounded-full <?= h($dots[$event['category'] ?? ''] ?? 'bg-muted-foreground') ?>" aria-hidden="true"></span>
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium"><?= h($event['title']) ?></p>
                                    <p class="text-muted-foreground text-xs">
                                        <time datetime="<?= h($event['date']) ?>" data-dnd-attr="datetime:{date}" data-dnd-text="short"><?= h((new Date($event['date']))->i18nFormat('EEE d MMM')) ?></time><?php if (!empty($event['time'])) : ?>, <?= h($event['time']) ?><?php endif; ?>
                                    </p>
                                    <?= $this->Badge->render((string)($categories[$event['category']] ?? $event['category']), ['variant' => 'outline', 'class' => 'mt-1']) ?>
                                </div>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                <?php else : ?>
                    <p class="text-muted-foreground text-sm"><?= h({{ t|raw }}'No upcoming events.')) ?></p>
                <?php endif; ?>
            </section>
            <?php if ($categories) : ?>
                <section class="rounded-lg border p-4" aria-labelledby="calendar-legend">
                    <h3 class="mb-3 text-sm font-semibold" id="calendar-legend"><?= h({{ t|raw }}'Categories')) ?></h3>
                    <ul class="flex flex-col gap-2">
                        <?php foreach ($categories as $key => $label) : ?>
                            <li class="flex items-center gap-2 text-sm">
                                <span class="size-2.5 shrink-0 rounded-full <?= h($dots[$key] ?? 'bg-muted-foreground') ?>" aria-hidden="true"></span>
                                <?= h($label) ?>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                </section>
            <?php endif; ?>
        </aside>
    </div>
</div>
