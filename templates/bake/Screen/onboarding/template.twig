{#
/**
 * BasecoatTheme bake template: `onboarding` screen (`bin/cake bake screen onboarding`).
 * Reads the view variables of data.php (steps, workspace, invites, plans, plan, timezones, digests,
 * preferences). Twig variables used: `namespace`, `useDomain` and `plugin` (strings use
 * `__d('<plugin>', ...)` under `--plugin`, `__()` otherwise, as bake's CRUD templates). The rest is the PHP view.
 */
-#}
{% set t = useDomain ? "__d('" ~ plugin ~ "', " : "__(" %}
{% set tn = useDomain ? "__dn('" ~ plugin ~ "', " : "__n(" %}
<?php
/**
 * Onboarding: five-step setup flow. With JS (basecoat-screens.js) the steps are panels of one page: Continue validates
 * the required fields and moves on without reloading, Back keeps the values. Without JS each step is a GET page: the step
 * comes from the `step` query parameter (1 to 5) and the other panels are hidden.
 *
 * @var \{{ namespace }}\View\AppView $this
 * @var array<string, string> $steps Step key => label, in order.
 * @var array<string, string> $workspace Sample workspace: name and slug.
 * @var array<int, string> $invites Emails listed in the team step.
 * @var array<string, array<string, string>> $plans Plan value => title, description, icon.
 * @var string $plan Selected plan.
 * @var array<string, string> $timezones Timezone value => label.
 * @var array<string, string> $digests Digest frequency value => label.
 * @var array<string, mixed> $preferences Defaults of the preferences step.
 */
$this->assign('title', {{ t|raw }}'Onboarding'));
$this->Html->css('BasecoatTheme.interactivity', ['block' => true]);
$this->Html->script('BasecoatTheme.basecoat-screens', ['block' => true, 'defer' => true]);

$stepKeys = array_keys($steps);
$count = count($stepKeys);
$current = max(1, min($count, (int)$this->getRequest()->getQuery('step', 1)));
$currentKey = $stepKeys[$current - 1] ?? null; // null when there are no steps
$workspace += ['name' => '', 'slug' => ''];
$indexUrl = $this->Url->build(['action' => 'index']);
$stepUrl = fn (int $number): string => $indexUrl . '?' . http_build_query(['step' => $number]);

// Heading and description of each step panel
$texts = [
    'workspace' => [{{ t|raw }}'Name your workspace'), {{ t|raw }}'This is where your team will keep its projects. You can change it later.')],
    'team' => [{{ t|raw }}'Invite your team'), {{ t|raw }}'Add the people you work with. You can skip this step and invite them later.')],
    'plan' => [{{ t|raw }}'Choose a plan'), {{ t|raw }}'Pick the plan that fits your team today. You can switch at any time.')],
    'preferences' => [{{ t|raw }}'Set your preferences'), {{ t|raw }}'Tell us how you like to work. Every option can be changed in settings.')],
    'done' => [{{ t|raw }}'Review and finish'), {{ t|raw }}'Check the summary below, then finish to open your workspace.')],
];

// The invited emails always offer three fields: the listed ones plus empty rows
$invites = array_values($invites);
$inviteFields = max(3, count($invites));
?>
<div class="mx-auto flex w-full max-w-2xl flex-col gap-6 px-4 lg:px-6">
    <?php if ($currentKey === null) : ?>
        <?= $this->EmptyState->render({{ t|raw }}'Nothing to set up'), [
            'description' => {{ t|raw }}'There are no onboarding steps yet.'),
            'icon' => 'list-checks',
        ]) ?>
    <?php else : ?>
    <?php
    // TODO: the values are not stored. Keep them between steps (session or a draft record) for the no-JS flow and
    // save everything when the flow is finished; with JS, listen to basecoat:step or post the five forms at the end.
    ?>
    <div class="flex flex-col gap-6" data-stepper data-stepper-start="<?= $current - 1 ?>"
        data-screens-i18n-step="<?= h({{ t|raw }}'Step {step} of {total}: {title}')) ?>">
    <nav aria-label="<?= h({{ t|raw }}'Progress')) ?>">
        <ol class="flex items-center gap-2">
            <?php foreach ($stepKeys as $index => $key) : ?>
                <?php
                $number = $index + 1;
                $state = $number === $current ? 'current' : ($number < $current ? 'complete' : 'upcoming');
                ?>
                <li class="group flex items-center gap-2 <?= $number < $count ? 'flex-1' : '' ?>" data-step-indicator data-state="<?= $state ?>"<?= $state === 'current' ? ' aria-current="step"' : '' ?>>
                    <span class="text-muted-foreground group-data-[state=current]:border-primary group-data-[state=current]:bg-primary group-data-[state=current]:text-primary-foreground group-data-[state=complete]:border-primary group-data-[state=complete]:text-primary flex size-8 shrink-0 items-center justify-center rounded-full border text-sm font-medium">
                        <span class="group-data-[state=complete]:hidden"><?= h((string)$number) ?></span>
                        <?= $this->Icon->render('check', ['class' => 'hidden size-4 group-data-[state=complete]:block']) ?>
                    </span>
                    <span class="text-muted-foreground group-data-[state=current]:text-foreground text-sm max-sm:sr-only group-data-[state=current]:font-medium group-data-[state=current]:max-sm:not-sr-only">
                        <?= h($steps[$key]) ?>
                        <span class="sr-only hidden group-data-[state=complete]:inline"><?= h({{ t|raw }}'Completed')) ?></span>
                        <span class="sr-only hidden group-data-[state=current]:inline"><?= h({{ t|raw }}'Current')) ?></span>
                    </span>
                    <?php if ($number < $count) : ?>
                        <span class="bg-border group-data-[state=complete]:bg-primary h-px min-w-3 flex-1" aria-hidden="true"></span>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ol>
    </nav>

    <p class="text-muted-foreground text-sm"><?= str_replace(['{current}', '{total}'], ['<span data-step-current>' . $current . '</span>', '<span data-step-total>' . $count . '</span>'], h({{ t|raw }}'Step {0} of {1}', '{current}', '{total}'))) ?></p>

    <?php foreach ($stepKeys as $index => $key) : ?>
        <?php
        $number = $index + 1;
        [$heading, $description] = $texts[$key] ?? [(string)$steps[$key], ''];
        ?>
        <div data-step data-step-title="<?= h($heading) ?>"<?= $number === $current ? '' : ' hidden' ?>>
    <?= $this->Card->start(['title' => $heading, 'description' => $description, 'titleTag' => 'h2']) ?>
        <?php if ($key !== 'done') : ?>
            <?= $this->Form->create(null, ['type' => 'get', 'url' => ['action' => 'index'], 'valueSources' => ['query'], 'class' => 'flex flex-col gap-6']) ?>
                <?= $this->Form->hidden('step', ['value' => $number + 1, 'id' => 'onboarding-next-step-' . $number]) ?>

                <?php if ($key === 'workspace') : ?>
                    <?= $this->Form->control('workspace_name', [
                        'label' => {{ t|raw }}'Workspace name'),
                        'value' => $workspace['name'],
                        'required' => true,
                        'autocomplete' => 'organization',
                    ]) ?>
                    <?= $this->Form->control('workspace_slug', [
                        'label' => {{ t|raw }}'Workspace URL'),
                        'value' => $workspace['slug'],
                        'required' => true,
                        'pattern' => '[a-z0-9\-]+',
                        'autocapitalize' => 'none',
                        'aria-describedby' => 'onboarding-slug-hint',
                    ]) ?>
                    <p class="text-muted-foreground -mt-4 text-sm" id="onboarding-slug-hint"><?= h({{ t|raw }}'Lowercase letters, numbers and hyphens only.')) ?></p>
                <?php elseif ($key === 'team') : ?>
                    <?php for ($i = 1; $i <= $inviteFields; $i++) : ?>
                        <?= $this->Form->control('invite_' . $i, [
                            'type' => 'email',
                            'label' => {{ t|raw }}'Teammate {0}', $i),
                            'value' => $invites[$i - 1] ?? '',
                            'placeholder' => {{ t|raw }}'name@example.com'),
                            'autocomplete' => 'off',
                        ]) ?>
                    <?php endfor; ?>
                <?php elseif ($key === 'plan') : ?>
                    <?= $this->ChoiceCards->render('plan', array_map(fn (array $item): array => [
                        'title' => $item['title'],
                        'description' => $item['description'],
                        'icon' => $item['icon'] ?? null,
                    ], $plans), [
                        'legend' => {{ t|raw }}'Plan'),
                        'value' => $plan,
                        'required' => true,
                        'id' => 'onboarding-plan',
                    ]) ?>
                <?php elseif ($key === 'preferences') : ?>
                    <?= $this->Form->control('timezone', [
                        'type' => 'select',
                        'label' => {{ t|raw }}'Timezone'),
                        'options' => $timezones,
                        'value' => $preferences['timezone'] ?? null,
                    ]) ?>
                    <?= $this->Form->control('digest', [
                        'type' => 'select',
                        'label' => {{ t|raw }}'Email digest'),
                        'options' => $digests,
                        'value' => $preferences['digest'] ?? null,
                    ]) ?>
                    <?= $this->Form->control('mentions', [
                        'type' => 'checkbox',
                        'role' => 'switch',
                        'label' => {{ t|raw }}'Email me when someone mentions me'),
                        'checked' => !empty($preferences['mentions']),
                        'hiddenField' => false,
                    ]) ?>
                    <?= $this->Form->control('product_updates', [
                        'type' => 'checkbox',
                        'role' => 'switch',
                        'label' => {{ t|raw }}'Send me product updates'),
                        'checked' => !empty($preferences['product_updates']),
                        'hiddenField' => false,
                    ]) ?>
                <?php endif; ?>

                <div class="flex items-center justify-between gap-2">
                    <?php if ($number > 1) : ?>
                        <?= $this->Button->link({{ t|raw }}'Back'), $stepUrl($number - 1), ['icon' => 'arrow-left', 'variant' => 'outline', 'data-step-prev' => '1']) ?>
                    <?php else : ?>
                        <span></span>
                    <?php endif; ?>
                    <?= $this->Button->submit({{ t|raw }}'Continue'), ['icon' => 'arrow-right', 'iconPosition' => 'end', 'data-step-next' => '1']) ?>
                </div>
            <?= $this->Form->end() ?>
        <?php else : ?>
            <dl class="flex flex-col gap-3 text-sm">
                <div class="flex justify-between gap-4">
                    <dt class="text-muted-foreground"><?= h({{ t|raw }}'Workspace')) ?></dt>
                    <dd class="font-medium"><?= h($workspace['name']) ?></dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-muted-foreground"><?= h({{ t|raw }}'Workspace URL')) ?></dt>
                    <dd class="font-medium break-all"><?= h($workspace['slug']) ?></dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-muted-foreground"><?= h({{ t|raw }}'Invitations')) ?></dt>
                    <dd class="font-medium"><?= h({{ tn|raw }}'{0} person', '{0} people', count(array_filter($invites)), count(array_filter($invites)))) ?></dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-muted-foreground"><?= h({{ t|raw }}'Plan')) ?></dt>
                    <dd class="font-medium"><?= h($plans[$plan]['title'] ?? $plan) ?></dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-muted-foreground"><?= h({{ t|raw }}'Timezone')) ?></dt>
                    <dd class="font-medium"><?= h($timezones[$preferences['timezone'] ?? ''] ?? '') ?></dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-muted-foreground"><?= h({{ t|raw }}'Email digest')) ?></dt>
                    <dd class="font-medium"><?= h($digests[$preferences['digest'] ?? ''] ?? '') ?></dd>
                </div>
            </dl>
            <div class="mt-6 flex items-center justify-between gap-2">
                <?= $this->Button->link({{ t|raw }}'Back'), $stepUrl($number - 1), ['icon' => 'arrow-left', 'variant' => 'outline', 'data-step-prev' => '1']) ?>
                <?php
                // TODO: "Finish" does nothing yet. Make it a POST form (Form->create + submit, with the
                // CSRF token) to your own action that saves the workspace and redirects to your dashboard.
                ?>
                <?= $this->Button->render({{ t|raw }}'Finish'), ['icon' => 'arrow-right', 'iconPosition' => 'end']) ?>
            </div>
        <?php endif; ?>
    <?= $this->Card->end() ?>
        </div>
    <?php endforeach; ?>
    </div>
    <?php endif; ?>
</div>
