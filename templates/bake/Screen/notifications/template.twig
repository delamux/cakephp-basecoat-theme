{#
/**
 * BasecoatTheme bake template: `notifications` screen (`bin/cake bake screen notifications`).
 * Reads the view variables of data.php (notifications, unreadCount, types, total, page, perPage).
 * Twig variables used: `namespace`, `useDomain` and `plugin` (strings use `__d('<plugin>', ...)`
 * under `--plugin`, `__()` otherwise, as bake's CRUD templates). The rest is the PHP view.
 */
-#}
{% set t = useDomain ? "__d('" ~ plugin ~ "', " : "__(" %}
<?php
/**
 * Notifications: inbox with unread highlighting, search and filters, and a paginated list.
 *
 * @var \{{ namespace }}\View\AppView $this
 * @var array<int, array<string, mixed>> $notifications Rows of this page: id, type, title, body, time, unread, actor.
 * @var int $unreadCount Unread notifications in the whole inbox.
 * @var array<string, string> $types Notification type => label.
 * @var int $total Notifications matching the filters, all pages.
 * @var int $page Current page.
 * @var int $perPage Notifications per page.
 */
$this->assign('title', {{ t }}'Notifications'));

// Footer: "Showing 1 to 10 of 24" and previous / next links that keep the current filters
$request = $this->getRequest();
$indexUrl = $this->Url->build(['action' => 'index']);
$pageUrl = fn (int $number): string => $indexUrl . '?' . http_build_query(['page' => $number] + $request->getQueryParams());
$filtered = array_filter(array_map(fn (string $name): string => (string)$request->getQuery($name, ''), ['q', 'status', 'type'])) !== [];
$pageCount = max(1, (int)ceil($total / max(1, $perPage)));
$first = $total > 0 ? ($page - 1) * $perPage + 1 : 0;
$last = $total > 0 ? $first + count($notifications) - 1 : 0;

// Title with the unread count; the count is hidden when everything is read
$heading = h({{ t }}'Inbox'));
if ($unreadCount > 0) {
    $heading .= ' ' . $this->Badge->render({{ t }}'{0} unread', $unreadCount), [
        'variant' => 'secondary',
        'class' => 'align-middle',
        'data-unread-count' => (string)$unreadCount,
    ]);
}
?>
<div class="flex flex-col gap-4 px-4 md:gap-6 lg:px-6">
    <?= $this->PageHeader->render($heading, [
        'level' => 2,
        'escape' => false,
        'description' => {{ t }}'Requests, mentions and updates from your workspace.'),
        'actions' => [
            // TODO: connect "Mark all as read" to an action of your controller (POST).
            $this->Button->render({{ t }}'Mark all as read'), [
                'icon' => 'check',
                'variant' => 'outline',
                'disabled' => $unreadCount === 0,
            ]),
            // TODO: link the settings button to your notification preferences page.
            $this->Button->icon('settings-2', {{ t }}'Notification settings'), ['variant' => 'ghost']),
        ],
    ]) ?>

    <?= $this->TableToolbar->render([
        'url' => $indexUrl,
        'filter' => [
            'q' => ['type' => 'search', 'label' => {{ t }}'Search notifications')],
            'status' => ['type' => 'select', 'label' => {{ t }}'Status'), 'options' => ['unread' => {{ t }}'Unread'), 'read' => {{ t }}'Read')]],
            'type' => ['type' => 'select', 'label' => {{ t }}'Type'), 'options' => $types],
        ],
    ]) ?>

    <section aria-label="<?= h({{ t }}'Notifications')) ?>">
        <?php if ($notifications) : ?>
            <?php
            // TODO: the Accept / Decline buttons do nothing yet. Pass
            // 'urls' => ['accept' => ['action' => 'accept', '{id}'], 'decline' => ['action' => 'decline', '{id}']]
            // to post to your own actions (POST forms with the CSRF token; '{id}' is the notification id).
            ?>
            <?= $this->NotificationList->render($notifications, ['types' => $types]) ?>
        <?php else : ?>
            <?= $this->EmptyState->render({{ t }}'No notifications'), [
                'description' => $filtered ? {{ t }}'Nothing matches these filters. Try a different search.') : {{ t }}"You're all caught up."),
                'icon' => 'inbox',
            ]) ?>
        <?php endif; ?>
    </section>

    <footer class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-muted-foreground text-sm">
            <?= h($total > 0 ? {{ t }}'Showing {0} to {1} of {2}', $first, $last, $total) : {{ t }}'Showing 0 of 0')) ?>
        </p>
        <nav class="flex items-center gap-2" aria-label="<?= h({{ t }}'Pagination')) ?>">
            <?php if ($page > 1) : ?>
                <?= $this->Button->link({{ t }}'Previous'), $pageUrl($page - 1), ['icon' => 'chevron-left', 'variant' => 'outline', 'size' => 'sm', 'rel' => 'prev']) ?>
            <?php else : ?>
                <?= $this->Button->render({{ t }}'Previous'), ['icon' => 'chevron-left', 'variant' => 'outline', 'size' => 'sm', 'disabled' => true]) ?>
            <?php endif; ?>
            <?php if ($page < $pageCount) : ?>
                <?= $this->Button->link({{ t }}'Next'), $pageUrl($page + 1), ['icon' => 'chevron-right', 'iconPosition' => 'end', 'variant' => 'outline', 'size' => 'sm', 'rel' => 'next']) ?>
            <?php else : ?>
                <?= $this->Button->render({{ t }}'Next'), ['icon' => 'chevron-right', 'iconPosition' => 'end', 'variant' => 'outline', 'size' => 'sm', 'disabled' => true]) ?>
            <?php endif; ?>
        </nav>
    </footer>
</div>
