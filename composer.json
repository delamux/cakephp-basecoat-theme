{
    "name": "delamux/cakephp-basecoat-theme",
    "description": "CakePHP 5 theme plugin for Basecoat UI (shadcn/ui look, no React): one configurable View Helper per component.",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": ["cakephp", "cakephp5", "plugin", "theme", "basecoat", "shadcn", "tailwind", "helpers"],
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.5 || ^11.1.3"
    },
    "autoload": {
        "psr-4": {
            "BasecoatTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BasecoatTheme\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
