#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * Generates the repetitive part of the calendar layout classes.
 *
 * Usage: php bin/build-calendar-css [--check]
 *
 * Rewrites, between their `@generated` markers:
 * - webroot/css/basecoat-calendar.css: row, span and row-count classes up to ROWS_MAX (24 hours at 5
 *   minutes), the column classes of the interactive grid up to COLS_MAX, and the slot backgrounds;
 * - src/View/Helper/CalendarHelper.php: the ROW, SPAN, ROWS and COL class maps (written out, so the
 *   helper and the stylesheet always agree).
 *
 * --check only compares: exit code 1 when a file is out of date (used by the tests).
 */

const ROWS_MAX = 288;
const COLS_MAX = 32;
const SLOTS = [5, 10, 15, 20, 30, 60];

$root = dirname(__DIR__);
$check = in_array('--check', $argv, true);

/**
 * @param string $prefix Class prefix.
 * @param int $max Last index.
 * @return string PHP array body, 4 entries per line.
 */
function phpMap(string $prefix, int $max): string
{
    $lines = [];
    foreach (array_chunk(range(1, $max), 4) as $chunk) {
        $lines[] = '        ' . implode(' ', array_map(fn (int $n): string => sprintf("%d => '%s-%d',", $n, $prefix, $n), $chunk));
    }

    return implode("\n", $lines);
}

$css = "/* @generated by bin/build-calendar-css: rows, spans and row counts (one row per slot, up to " . ROWS_MAX
    . " = 24 hours at 5 minutes), interactive grid columns (up to " . COLS_MAX . ") and slot backgrounds */\n";
for ($n = 1; $n <= ROWS_MAX; $n++) {
    $css .= ".bc-cal-row-$n{grid-row-start:$n}\n";
}
for ($n = 1; $n <= ROWS_MAX; $n++) {
    $css .= ".bc-cal-span-$n{grid-row-end:span $n}\n";
}
for ($n = 1; $n <= ROWS_MAX; $n++) {
    $css .= ".bc-cal-rows-$n{grid-template-rows:repeat($n,var(--bc-cal-row))}\n";
}
for ($n = 1; $n <= COLS_MAX; $n++) {
    $css .= ".bc-cal-cols-$n{--bc-cal-n:$n}\n";
}
// After the lane rules (same specificity): the column wins over a lane's grid-column
for ($n = 1; $n <= COLS_MAX; $n++) {
    $css .= ".bc-cal-grid-body>.bc-cal-c-$n{grid-column:$n}\n";
}
foreach (SLOTS as $slot) {
    $perHour = intdiv(60, $slot);
    $css .= $perHour === 1
        ? ".bc-cal-slot-$slot{background-image:linear-gradient(to bottom,var(--bc-cal-line) 1px,transparent 1px);background-size:100% var(--bc-cal-row)}\n"
        : ".bc-cal-slot-$slot{background-image:linear-gradient(to bottom,var(--bc-cal-line) 1px,transparent 1px),linear-gradient(to bottom,var(--bc-cal-line-soft) 1px,transparent 1px);background-size:100% calc(var(--bc-cal-row) * $perHour),100% var(--bc-cal-row)}\n";
}
$css .= "/* @generated-end */\n";

$php = "    // @generated by bin/build-calendar-css (do not edit by hand)\n"
    . "    /**\n     * Layout classes of `basecoat-calendar.css`, written out so any CSS scanner finds them.\n     *\n     * @var array<int, string>\n     */\n"
    . "    protected const ROW = [\n" . phpMap('bc-cal-row', ROWS_MAX) . "\n    ];\n\n"
    . "    /**\n     * @var array<int, string>\n     */\n"
    . "    protected const SPAN = [\n" . phpMap('bc-cal-span', ROWS_MAX) . "\n    ];\n\n"
    . "    /**\n     * @var array<int, string>\n     */\n"
    . "    protected const ROWS = [\n" . phpMap('bc-cal-rows', ROWS_MAX) . "\n    ];\n\n"
    . "    /**\n     * Column of an event in the interactive grid (1-based).\n     *\n     * @var array<int, string>\n     */\n"
    . "    protected const COL = [\n" . phpMap('bc-cal-c', COLS_MAX) . "\n    ];\n\n"
    . "    /**\n     * Number of columns of the interactive grid.\n     *\n     * @var array<int, string>\n     */\n"
    . "    protected const COLS = [\n" . phpMap('bc-cal-cols', COLS_MAX) . "\n    ];\n"
    . "    // @generated-end\n";

$targets = [
    $root . '/webroot/css/basecoat-calendar.css' => ['#/\* @generated by bin/build-calendar-css.*?/\* @generated-end \*/\n#s', $css],
    $root . '/src/View/Helper/CalendarHelper.php' => ['#    // @generated by bin/build-calendar-css.*?    // @generated-end\n#s', $php],
];
$stale = false;
foreach ($targets as $file => [$pattern, $block]) {
    $current = (string)file_get_contents($file);
    if (!preg_match($pattern, $current)) {
        fwrite(STDERR, "No @generated block in $file\n");
        exit(1);
    }
    $next = (string)preg_replace_callback($pattern, fn (): string => $block, $current, 1);
    if ($next === $current) {
        continue;
    }
    if ($check) {
        fwrite(STDERR, "Out of date: $file (run php bin/build-calendar-css)\n");
        $stale = true;
        continue;
    }
    file_put_contents($file, $next);
    echo "Updated $file\n";
}
exit($stale ? 1 : 0);
